# PFA-Dialyse environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored - never commit it.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- SMTP (password reset emails) ---
# If EMAIL_HOST_PASSWORD is unset, Django uses the console email backend
# (mail is printed to stdout instead of sent). Set these to enable real mail.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- AI / vision service (server.py) ---
HF_TOKEN=
AI_API_URL=http://127.0.0.1:8001/analyze/

# --- Edge / Raspberry Pi client (edge_client.py, producer.py) ---
# Shared secret for the machine-to-machine endpoints (/api/push/,
# /api/seance/debit/, /machines/raspi/heartbeat/). Must be identical for the
# Django server and the edge clients (sent as X-Device-Token).
# Fail-closed: when empty, those endpoints reject every request.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=dialysis/machine
MQTT_USERNAME=
MQTT_PASSWORD=
RASPI_ID=RASPI-01
MACHINE_ID=
DJANGO_BASE_URL=http://127.0.0.1:8000
RASPI_IMAGE_PATH=frame.jpg
RASPI_DEFAULT_DEBIT=60

# --- MQTT simulator (mqtt_simulator.py) ---
SIM_INTERVAL=3

# --- MQTT listener (mqtt_listener.py) ---
MQTT_TOPIC=dialysis/machine/#